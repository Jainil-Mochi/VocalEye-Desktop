<UserControl x:Class="VocalEye.Desktop.App.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:VocalEye.Desktop.App.Controls"
             xmlns:cv="clr-namespace:VocalEye.Desktop.App.Converters"
             xmlns:vm="clr-namespace:VocalEye.Desktop.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="720" d:DesignWidth="1100"
             d:DataContext="{d:DesignInstance vm:ChatViewModel}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/VocalEye.Desktop.App;component/Themes/ChatTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <cv:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis"/>
            <cv:NullOrEmptyToCollapsedConverter x:Key="NullToCollapsed"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource WorkspaceBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ───────── Sidebar ───────── -->
        <Grid Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="VocalEye" Margin="20,22,20,14" FontSize="22" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>

            <Button Grid.Row="1" Margin="16,0,16,16" Style="{StaticResource AccentButton}"
                    Content="+  New Chat" Command="{Binding NewChatCommand}"
                    AutomationProperties.Name="New chat"/>

            <TextBlock Grid.Row="2" Text="RECENT CHATS" Margin="20,0,20,6" FontSize="11" FontWeight="SemiBold"
                       Foreground="{StaticResource TextSecondaryBrush}"/>

            <ListBox Grid.Row="3" x:Name="ConversationList" ItemsSource="{Binding Conversations}"
                     SelectedItem="{Binding SelectedConversation, Mode=TwoWay}"
                     Background="Transparent" BorderThickness="0" Margin="8,0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     AutomationProperties.Name="Conversations">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" CornerRadius="8" Padding="10,8" Margin="0,1" Background="Transparent"
                                            BorderThickness="1" BorderBrush="Transparent">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderBrushSubtle}"/>
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource TextPrimaryBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ConversationSummaryViewModel}">
                        <Grid Background="Transparent">
                            <Grid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Rename"
                                              Command="{Binding PlacementTarget.Tag.BeginRenameCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding}"/>
                                    <MenuItem Header="Delete"
                                              Command="{Binding PlacementTarget.Tag.DeleteConversationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding}"/>
                                </ContextMenu>
                            </Grid.ContextMenu>
                            <Grid.Tag>
                                <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                            </Grid.Tag>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{Binding DisplayTitle}" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"
                                       Visibility="{Binding IsEditing, Converter={StaticResource InvBoolToVis}}"/>

                            <TextBox Grid.Column="0" Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}"
                                     Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"
                                     Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                                     CaretBrush="White" BorderBrush="{StaticResource BorderBrushSubtle}" Padding="4,2"
                                     AutomationProperties.Name="Conversation title" Loaded="RenameBox_Loaded"
                                     IsVisibleChanged="RenameBox_IsVisibleChanged" KeyDown="RenameBox_KeyDown"/>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Button Style="{StaticResource GhostButton}" Content="✎" ToolTip="Rename"
                                        AutomationProperties.Name="Rename conversation"
                                        Command="{Binding DataContext.BeginRenameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                                <Button Style="{StaticResource GhostButton}" Content="🗑" ToolTip="Delete"
                                        AutomationProperties.Name="Delete conversation"
                                        Command="{Binding DataContext.DeleteConversationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                        Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                                <Button Style="{StaticResource GhostButton}" Content="✓" ToolTip="Save"
                                        AutomationProperties.Name="Save title"
                                        Command="{Binding DataContext.RenameConversationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                                <Button Style="{StaticResource GhostButton}" Content="✕" ToolTip="Cancel"
                                        AutomationProperties.Name="Cancel rename"
                                        Command="{Binding DataContext.CancelRenameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Grid.Row="3" Text="No conversations yet.&#10;Start one with New Chat." TextAlignment="Center"
                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Top" Margin="20,24"
                       Visibility="{Binding HasConversations, Converter={StaticResource InvBoolToVis}}"/>

            <StackPanel Grid.Row="4" Margin="20,12,20,18">
                <TextBlock Text="BACKEND STATUS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Ellipse Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#F59E0B"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Fill" Value="#22C55E"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding ConnectionStatus}" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ───────── Main workspace ───────── -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Padding="28,16" BorderBrush="{StaticResource BorderBrushSubtle}" BorderThickness="0,0,0,1">
                <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"
                           Text="{Binding SelectedConversation.DisplayTitle, FallbackValue='New conversation', TargetNullValue='New conversation'}"
                           TextTrimming="CharacterEllipsis"/>
            </Border>

            <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="3" BorderThickness="0" Background="Transparent"
                         Foreground="{StaticResource AccentBrush}"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                         AutomationProperties.Name="Loading"/>

            <!-- Error banner -->
            <Border Grid.Row="2" Margin="28,12,28,0" Padding="14,10" CornerRadius="10"
                    Background="{StaticResource ErrorBrush}" BorderBrush="{StaticResource ErrorBorderBrush}" BorderThickness="1"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsed}}">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="✕"
                            Command="{Binding DismissErrorCommand}" AutomationProperties.Name="Dismiss error"/>
                    <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="Retry" Margin="8,0" Padding="12,4"
                            Command="{Binding RetryCommand}" Visibility="{Binding CanRetry, Converter={StaticResource BoolToVis}}"
                            AutomationProperties.Name="Retry"/>
                    <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <!-- Messages + welcome -->
            <Grid Grid.Row="3">
                <ScrollViewer x:Name="MessageScroller" VerticalScrollBarVisibility="Auto" Padding="0,8">
                    <ItemsControl ItemsSource="{Binding Messages}" Margin="28,8" AutomationProperties.Name="Messages">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel MaxWidth="860"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ChatMessageViewModel}">
                                <Grid Margin="0,8">
                                    <!-- User bubble -->
                                    <Border HorizontalAlignment="Right" MaxWidth="620" CornerRadius="16,16,4,16" Padding="16,10"
                                            Background="{StaticResource AccentBrush}"
                                            Visibility="{Binding IsUser, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="White"/>
                                    </Border>

                                    <!-- Assistant -->
                                    <StackPanel Visibility="{Binding IsAssistant, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="VocalEye" FontSize="12" FontWeight="SemiBold" Margin="2,0,0,4"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <Border CornerRadius="4,16,16,16" Padding="16,12" Background="{StaticResource SurfaceBrush}"
                                                BorderBrush="{StaticResource BorderBrushSubtle}" BorderThickness="1" HorizontalAlignment="Left">
                                            <StackPanel>
                                                <ctl:MarkdownViewer Markdown="{Binding Text}" Foreground="{StaticResource TextPrimaryBrush}"
                                                                    FontSize="14" AutomationProperties.Name="Assistant message"
                                                                    Visibility="{Binding HasText, Converter={StaticResource BoolToVis}}"/>

                                                <!-- Tool results -->
                                                <ItemsControl ItemsSource="{Binding ToolResults}" Margin="0,6,0,0"
                                                              AutomationProperties.Name="Tool results">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:ToolResultViewModel}">
                                                            <Border Background="{StaticResource SidebarBrush}" CornerRadius="10" Padding="12,10" Margin="0,4"
                                                                    BorderBrush="{StaticResource BorderBrushSubtle}" BorderThickness="1">
                                                                <StackPanel>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock FontWeight="Bold" Margin="0,0,8,0" Text="✓" Foreground="#22C55E">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding Success}" Value="False">
                                                                                            <Setter Property="Text" Value="✕"/>
                                                                                            <Setter Property="Foreground" Value="#F43F5E"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                                        <TextBlock Text="{Binding StatusText}" Margin="8,0,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                    </StackPanel>

                                                                    <!-- A failed tool shows its reason right away -->
                                                                    <TextBlock Text="{Binding Output}" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#FDA4AF">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Success}" Value="False">
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>

                                                                    <Expander Header="Details" Margin="0,6,0,0" Foreground="{StaticResource TextSecondaryBrush}"
                                                                              Visibility="{Binding HasOutput, Converter={StaticResource BoolToVis}}">
                                                                        <TextBox Text="{Binding Output, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                                                                 MaxHeight="200" VerticalScrollBarVisibility="Auto" BorderThickness="0"
                                                                                 Background="Transparent" Foreground="{StaticResource TextPrimaryBrush}"
                                                                                 FontFamily="Cascadia Mono, Consolas" FontSize="12" Margin="0,4,0,0"
                                                                                 AutomationProperties.Name="Tool output"/>
                                                                    </Expander>

                                                                    <ItemsControl ItemsSource="{Binding Artifacts}" Margin="0,6,0,0">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate DataType="{x:Type vm:ArtifactViewModel}">
                                                                                <DockPanel Margin="0,3">
                                                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                                                        <Button Content="{Binding OpenLabel}" Command="{Binding OpenCommand}"
                                                                                                Style="{StaticResource AccentButton}" Padding="10,4" Margin="6,0,0,0"
                                                                                                AutomationProperties.Name="Open result"/>
                                                                                        <Button Content="Show in folder" Command="{Binding RevealCommand}"
                                                                                                Style="{StaticResource GhostButton}" Padding="10,4" Margin="6,0,0,0"
                                                                                                Visibility="{Binding CanReveal, Converter={StaticResource BoolToVis}}"
                                                                                                AutomationProperties.Name="Show result in folder"/>
                                                                                    </StackPanel>
                                                                                    <TextBlock Text="{Binding DisplayName}" ToolTip="{Binding Path}" VerticalAlignment="Center"
                                                                                               TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                                                </DockPanel>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <!-- Approval cards -->
                                                <ItemsControl ItemsSource="{Binding Approvals}" Margin="0,6,0,0"
                                                              AutomationProperties.Name="Tool approvals">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:ApprovalCardViewModel}">
                                                            <Border Background="#1B2347" CornerRadius="12" Padding="14" Margin="0,6" MinWidth="420"
                                                                    BorderBrush="#7C3AED" BorderThickness="1">
                                                                <StackPanel>
                                                                    <DockPanel>
                                                                        <Border DockPanel.Dock="Right" CornerRadius="8" Padding="8,2" VerticalAlignment="Center">
                                                                            <Border.Style>
                                                                                <Style TargetType="Border">
                                                                                    <Setter Property="Background" Value="#33F59E0B"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding RiskKey}" Value="Destructive">
                                                                                            <Setter Property="Background" Value="#55F43F5E"/>
                                                                                        </DataTrigger>
                                                                                        <DataTrigger Binding="{Binding RiskKey}" Value="ReadOnly">
                                                                                            <Setter Property="Background" Value="#333B82F6"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Border.Style>
                                                                            <TextBlock Text="{Binding RiskLabel}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                                        </Border>
                                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="15"
                                                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                                                    </DockPanel>

                                                                    <TextBlock Text="{Binding Summary.Headline}" TextWrapping="Wrap" Margin="0,8,0,8"
                                                                               Foreground="{StaticResource TextPrimaryBrush}"/>

                                                                    <ItemsControl ItemsSource="{Binding Summary.Fields}">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <Grid Margin="0,2">
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="90"/>
                                                                                        <ColumnDefinition Width="*"/>
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <TextBlock Text="{Binding Label}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                                    <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap"
                                                                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                                                                </Grid>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>

                                                                    <ItemsControl ItemsSource="{Binding Summary.Previews}" Margin="0,6,0,0">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <Expander Header="{Binding Label}" IsExpanded="{Binding ExpandedByDefault, Mode=OneWay}"
                                                                                          Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2">
                                                                                    <StackPanel>
                                                                                        <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                                                                                 MaxHeight="240" VerticalScrollBarVisibility="Auto"
                                                                                                 Background="{StaticResource SidebarBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                                                                                                 BorderBrush="{StaticResource BorderBrushSubtle}" Padding="8" Margin="0,4,0,0"
                                                                                                 FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                                                                                 AutomationProperties.Name="Preview of what will be created or sent"/>
                                                                                        <TextBlock Text="{Binding Caption}" FontSize="11" Margin="0,2,0,0"
                                                                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                                    </StackPanel>
                                                                                </Expander>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>

                                                                    <CheckBox Content="Show raw arguments" IsChecked="{Binding ShowRawArguments}" Margin="0,8,0,0"
                                                                              Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                    <TextBox Text="{Binding RawArguments, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                                                             MaxHeight="200" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0" Padding="8"
                                                                             Background="{StaticResource SidebarBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                                                                             BorderBrush="{StaticResource BorderBrushSubtle}"
                                                                             FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                                                             Visibility="{Binding ShowRawArguments, Converter={StaticResource BoolToVis}}"
                                                                             AutomationProperties.Name="Raw tool arguments"/>

                                                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0"
                                                                                Visibility="{Binding IsPending, Converter={StaticResource BoolToVis}}">
                                                                        <Button Content="Approve" Style="{StaticResource AccentButton}" Padding="18,7"
                                                                                Command="{Binding DataContext.ApproveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                CommandParameter="{Binding}" AutomationProperties.Name="Approve this action"/>
                                                                        <Button Content="Deny" Style="{StaticResource GhostButton}" Padding="18,7" Margin="8,0,0,0"
                                                                                Command="{Binding DataContext.DenyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                CommandParameter="{Binding}" AutomationProperties.Name="Deny this action"/>
                                                                    </StackPanel>
                                                                    <TextBlock Text="{Binding StatusText}" FontSize="12" Margin="0,8,0,0"
                                                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <TextBlock Text="{Binding ToolSummary}" FontSize="12" Margin="0,6,0,0"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           Visibility="{Binding ToolSummary, Converter={StaticResource NullToCollapsed}}"/>
                                                <TextBlock Text="Responding…" FontSize="12" Margin="0,6,0,0" FontStyle="Italic"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           Visibility="{Binding IsStreaming, Converter={StaticResource BoolToVis}}"/>
                                                <TextBlock Text="{Binding ModelLabel}" FontSize="11" Margin="0,6,0,0"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           Visibility="{Binding ModelLabel, Converter={StaticResource NullToCollapsed}}"/>
                                                <TextBlock Text="Response stopped before it finished." FontSize="12" Margin="0,6,0,0"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           Visibility="{Binding IsIncomplete, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                            Visibility="{Binding ShowWelcome, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Welcome to VocalEye" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Ask anything to get started." Margin="0,8,0,0" HorizontalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </Grid>

            <!-- Approvals banner + composer -->
            <StackPanel Grid.Row="4" MaxWidth="860" Margin="28,0,28,0">
            <Border Margin="0,6,0,0" Padding="14,8" CornerRadius="10" Background="#33F59E0B" BorderBrush="#F59E0B" BorderThickness="1"
                    Visibility="{Binding HasPendingApprovals, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Deny all" Style="{StaticResource GhostButton}" Padding="12,4"
                            Command="{Binding DenyAllCommand}" AutomationProperties.Name="Deny all waiting actions"/>
                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}"
                               Text="{Binding PendingApprovalsText}"/>
                </DockPanel>
            </Border>
            <Border Margin="0,8,0,22" Padding="14,10" CornerRadius="16"
                    Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushSubtle}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="Composer" Grid.Column="0" Text="{Binding DraftMessage, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="24" MaxHeight="160"
                             VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent"
                             Foreground="{StaticResource TextPrimaryBrush}" CaretBrush="White" FontSize="14"
                             VerticalContentAlignment="Center" PreviewKeyDown="Composer_PreviewKeyDown"
                             AutomationProperties.Name="Message composer"
                             AutomationProperties.HelpText="Type a message. Enter sends, Shift+Enter adds a new line."/>

                    <TextBlock Grid.Column="0" Text="Ask VocalEye…" IsHitTestVisible="False" Margin="2,0,0,0"
                               VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text.Length, ElementName=Composer}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Button Grid.Column="1" Margin="10,0,0,0" Content="Send" Style="{StaticResource AccentButton}"
                            Command="{Binding SendMessageCommand}" AutomationProperties.Name="Send message"
                            Visibility="{Binding IsStreaming, Converter={StaticResource InvBoolToVis}}"/>
                    <Button Grid.Column="1" Margin="10,0,0,0" Content="■  Stop" Style="{StaticResource AccentButton}"
                            Command="{Binding StopResponseCommand}" AutomationProperties.Name="Stop response"
                            Visibility="{Binding IsStreaming, Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>

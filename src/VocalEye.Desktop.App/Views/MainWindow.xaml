<Window x:Class="VocalEye.Desktop.App.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="{Binding Title}" Height="420" Width="680" MinHeight="360" MinWidth="560" WindowStartupLocation="CenterScreen" Background="#F4F6FA">
<Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="VocalEye Desktop" FontSize="28" FontWeight="Bold" Foreground="#172033"/><TextBlock Text="Backend connection dashboard" Margin="0,6,0,0" FontSize="14" Foreground="#65718A"/></StackPanel>
<Border Grid.Row="2" Background="White" CornerRadius="14" Padding="24" BorderBrush="#E0E5EF" BorderThickness="1"><StackPanel>
<TextBlock Text="API STATUS" FontSize="12" FontWeight="SemiBold" Foreground="#65718A"/>
<StackPanel Orientation="Horizontal" Margin="0,12,0,18"><Ellipse Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,10,0"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="#9AA3B2"/><Style.Triggers><DataTrigger Binding="{Binding IsConnected}" Value="True"><Setter Property="Fill" Value="#22A06B"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse><TextBlock Text="{Binding ConnectionStatus}" FontSize="20" FontWeight="SemiBold" Foreground="#172033" VerticalAlignment="Center"/></StackPanel>
<TextBlock Text="{Binding BackendDetails}" TextWrapping="Wrap" Foreground="#65718A" Margin="0,0,0,22"/>
<Button Content="Check connection" Command="{Binding ConnectCommand}" Height="42" Width="170" HorizontalAlignment="Left" Background="#2457D6" Foreground="White" BorderThickness="0"/>
<TextBlock Text="Configure the backend URL and project path in appsettings.json." Margin="0,20,0,0" Foreground="#7B8496" FontSize="12" TextWrapping="Wrap"/>
</StackPanel></Border><TextBlock Grid.Row="3" Text="Phase 1 • Backend process and health check" Margin="0,16,0,0" Foreground="#7B8496" FontSize="11" HorizontalAlignment="Right"/>
</Grid></Window>
